# Build output and CMake cache -- regenerate with cmake --preset + ninja.
/out/
/build/

# Codegen output -- regenerated from the manifest + the retail XEX via
# `cmake --build . --target forzahorizon2_codegen`. Not committed: derived
# from a copyrighted game binary that is never itself part of this repo,
# and at ~500MB it isn't practical to version anyway.
/generated/

# Session/runtime state written by the SDK at run time (logs, caches, user
# profile data) -- never source, always local to a machine/run.
/_state_cache/
/_state_logs/
/_state_user/
/cache/
/cache0/
/cache1/
/content/
/user/

# Backup files left by manual edits during debugging sessions.
*.bak
*.bak_*

# IDE/editor
.vs/
.vscode/
*.user

# Never the retail game itself -- this repo is the recompilation project,
# not a game data distribution.
*.xex
*.xbe
*.iso
*.xiso
